# Copy to `.env` and fill in.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Stable low-latency model (see https://ai.google.dev/gemini-api/docs/models/gemini )
GEMINI_MODEL=gemini-2.5-flash
# RevenueCat server-side keys (never place in client)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_V2_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_PROJECT_ID=projfdc295f4
# Notification queue cron secret (never place in client)
NOTIFICATION_CRON_SECRET=
# Mission Control Admin access & optional Discord/Slack webhook alerts
ADMIN_UIDS=Kp6J1wDQd5huj8FRrp3Vb3EuJ333
ADMIN_EMAILS=
ADMIN_ALERT_WEBHOOK_URL=

      {
        "id": "omakase_slide_03",
        "layout": "device-bottom",
        "label": {
          "en": "DEEP DIVE",
          "tr": "DERİN İNCELEME",
          "ja": "深掘り",
          "de": "TIEFENBLICK",
          "fr": "APPROFONDIR",
          "es": "A FONDO",
          "ko": "심층 탐구"
        },
        "headline": {
          "en": "Caught your interest?\n\nDive deeper.",
          "ja": "気になる話に出会った？\n\nもっと深く潜れる。",
          "de": "Neugierig geworden?\n\nTauche tiefer ein.",
          "fr": "Ça t'intrigue ?\n\nCreuse le sujet.",
          "es": "¿Te despertó curiosidad?\n\nProfundiza al instante.",
          "ko": "흥미가 생겼나요?\n\n더 깊이 파고들어 보세요.",
          "tr": "Post ilgini mi çekti?\n\nDerine inebilirsin."
        },

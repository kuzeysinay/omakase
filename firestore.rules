rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
//   - id: string (matches userId, immutable)
//   - displayName: string (required, <= 100 chars)
//   - username: string (optional, <= 40 chars)
//   - photoURL: string (optional, <= 2048 chars)
//   - interests: list<string> (optional, <= 100 items)
//   - createdAt: timestamp (required)
//   - searchableName: string (optional, <= 100 chars)
//   - searchableUsername: string (optional, <= 40 chars)
//   - usernameUpdatedAt: timestamp/null (optional, enforces 14-day username change cooldown)
//   - profileSetupCompleted: bool/null (optional)
//   (Note: `email` is intentionally forbidden to prevent PII exposure on authenticated reads.)
//
// Collection: usernames/{handle}
//   Document ID: lowercase handle matching ^[a-z0-9_.]{3,20}$
//   - uid: string (required, matches request.auth.uid)
//   - createdAt: timestamp (optional)
//
// Subcollection: users/{userId}/following/{targetUid}
//   - followedAt: timestamp
//   - targetDisplayName: string (optional, <= 100 chars)
//
// Subcollection: users/{userId}/followers/{followerUid}
//   - followedAt: timestamp
//   - followerDisplayName: string (optional, <= 100 chars)
//
// Subcollection: users/{userId}/blocked_users/{blockedUid}
//   - blockedUid: string (optional, <= 128 chars)
//   - blockedAt: timestamp (optional)
//   - displayName: string (optional, <= 100 chars)
//
// Subcollection: users/{userId}/devices/{deviceId}
//   Document ID: <= 128 chars; owner-only.
//   - fcmToken: string (required, 1..512 chars)
//   - platform: string (required, must be 'ios')
//   - language: string (optional, one of 'en', 'tr', 'ja', 'de', 'fr', 'es', 'ko')
//   - timezone: string (optional, <= 64 chars)
//   - updatedAt: timestamp (optional)
//
// Subcollection: users/{userId}/notification_prefs/{prefId}
//   Document ID: 'settings'; owner-only.
//   - dailyReminderEnabled: bool (required)
//   - reminderHour: int (required, 0..23)
//   - reminderMinute: int (required, 0..59)
//   - commentPushEnabled: bool (required)
//   - dailyDigestEnabled: bool (required)
//   - timezone: string (required, 1..64 chars)
//   - language: string (required, one of 'en', 'tr', 'ja', 'de', 'fr', 'es', 'ko')
//   - updatedAt: timestamp (optional)
//
// Collection: shared_posts/{postId}
//   - authorId: string (required, matches creator UID, immutable)
//   - authorName: string (required, <= 100 chars)
//   - authorUsername: string (optional, <= 40 chars)
//   - authorPhotoURL: string (optional, <= 2048 chars)
//   - title: string (required, <= 500 chars)
//   - text: string (required, <= 20000 chars)
//   - tags: list<string> (optional, <= 30 items)
//   - originalCreatedAt: timestamp (required)
//   - sharedAt: timestamp (required)
//   - deepDiveText: string (optional, <= 50000 chars)
//   - reactionCounts: map<string, int> (optional)
//   - totalReactions: int (optional)
//   - commentCount: int (optional)
//   - reportedBy: list<string> (optional, <= 1000 items)
//
// Subcollection: shared_posts/{postId}/reactions/{reactionUid}
//   - emoji: string (required, <= 32 chars)
//   - reactedAt: timestamp (required)
//
// Subcollection: shared_posts/{postId}/comments/{commentId}
//   - authorId: string (required, matches creator UID, immutable)
//   - authorName: string (required, <= 100 chars)
//   - authorPhotoURL: string (optional, <= 2048 chars)
//   - text: string (required, 1..280 chars)
//   - createdAt: timestamp (required)
//   - reportedBy: list<string> (optional, <= 1000 items)
//
// Collection: moderation_reports/{reportId}
//   - reporterUid: string (required, matches request.auth.uid)
//   - targetType: string (optional, <= 64 chars)
//   - targetId: string (optional, <= 256 chars)
//   - postId: string (optional, <= 256 chars)
//   - commentId: string (optional, <= 256 chars)
//   - reportedAuthorUid: string (optional, <= 128 chars)
//   - reason: string (optional, <= 1000 chars)
//   - createdAt: timestamp (optional)
//
// Collection: entitlements/{userId}
//   Server-managed only (written exclusively by Cloud Run Firebase Admin SDK).
//   - isPro: bool
//   - status: string
//   - productId: string/null
//   - expiresAt: timestamp/string/null
//   - willRenew: bool
//   - source: string
//   - updatedAt: timestamp/string
//
// Collection: usage/{docId}
//   Document ID: {uid}_{yyyymmdd}
//   Server-managed only (written exclusively by Cloud Run Firebase Admin SDK).
//   - uid: string
//   - dayKey: string
//   - platesUsed: int
//   - deepDivesUsed: int
//   - suggestionsUsed: int
//   - bonusDeepDives: int
//   - shareBonusClaimed: bool
//   - updatedAt: string
//
// Collection: notification_queue/{docId}
//   Server-managed only (written and read exclusively by Cloud Run / Cloud Scheduler via Firebase Admin SDK; all client access denied).
//
// Collection: notification_cooldowns/{docId}
//   Server-managed only (written and read exclusively by Cloud Run via Firebase Admin SDK; all client access denied).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPostAuthor(postId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/shared_posts/$(postId)).data.authorId == request.auth.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly([
          'id',
          'displayName',
          'username',
          'photoURL',
          'interests',
          'createdAt',
          'searchableName',
          'searchableUsername',
          'usernameUpdatedAt',
          'profileSetupCompleted'
        ]) &&
        !data.keys().hasAny([
          'isPro',
          'is_pro',
          'entitlement',
          'entitlements',
          'tier',
          'plan',
          'subscriptionStatus',
          'quota',
          'usage'
        ]) &&
        (!('id' in data) || data.id == userId) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 40)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('interests' in data) || (data.interests is list && data.interests.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('searchableName' in data) || (data.searchableName is string && data.searchableName.size() <= 100)) &&
        (!('searchableUsername' in data) || data.searchableUsername == null || (data.searchableUsername is string && data.searchableUsername.size() <= 40)) &&
        (!('usernameUpdatedAt' in data) || data.usernameUpdatedAt == null || data.usernameUpdatedAt is timestamp) &&
        (!('profileSetupCompleted' in data) || data.profileSetupCompleted == null || data.profileSetupCompleted is bool);
    }

    function isValidUsernameUpdate() {
      let oldUsername = resource.data.get('username', null);
      let newUsername = request.resource.data.get('username', null);
      let oldSearchable = resource.data.get('searchableUsername', null);
      let newSearchable = request.resource.data.get('searchableUsername', null);
      let oldUpdatedAt = resource.data.get('usernameUpdatedAt', null);
      let newUpdatedAt = request.resource.data.get('usernameUpdatedAt', null);
      let usernameChanged = (newUsername != oldUsername) || (newSearchable != oldSearchable);
      return
        (!usernameChanged ||
          oldUsername == null ||
          oldUpdatedAt == null ||
          (request.time >= oldUpdatedAt + duration.value(14, 'd') &&
           newUpdatedAt is timestamp &&
           newUpdatedAt >= request.time - duration.value(5, 'm') &&
           newUpdatedAt <= request.time + duration.value(5, 'm'))) &&
        (oldUpdatedAt == null ||
          (newUpdatedAt is timestamp && newUpdatedAt >= oldUpdatedAt));
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasOnly(['uid', 'createdAt']) &&
        data.keys().hasAll(['uid']) &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidFollowDoc(data) {
      return data.keys().hasOnly([
          'followedAt',
          'targetDisplayName',
          'followerDisplayName'
        ]) &&
        (!('followedAt' in data) || data.followedAt is timestamp) &&
        (!('targetDisplayName' in data) || data.targetDisplayName == null || (data.targetDisplayName is string && data.targetDisplayName.size() <= 100)) &&
        (!('followerDisplayName' in data) || data.followerDisplayName == null || (data.followerDisplayName is string && data.followerDisplayName.size() <= 100));
    }

    function isValidBlockedUserDoc(data) {
      return data.keys().hasOnly([
          'blockedUid',
          'blockedAt',
          'displayName'
        ]) &&
        (!('blockedUid' in data) || data.blockedUid == null || (data.blockedUid is string && data.blockedUid.size() <= 128)) &&
        (!('blockedAt' in data) || data.blockedAt is timestamp) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100));
    }

    function isValidSharedPost(data) {
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorUsername',
          'authorPhotoURL',
          'title',
          'text',
          'tags',
          'originalCreatedAt',
          'sharedAt',
          'deepDiveText',
          'reactionCounts',
          'totalReactions',
          'commentCount',
          'reportedBy'
        ]) &&
        data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
        data.title is string && data.title.size() <= 500 &&
        data.text is string && data.text.size() <= 20000 &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorUsername' in data) || data.authorUsername == null || (data.authorUsername is string && data.authorUsername.size() <= 40)) &&
        (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
        (!('originalCreatedAt' in data) || data.originalCreatedAt is timestamp) &&
        (!('sharedAt' in data) || data.sharedAt is timestamp) &&
        (!('deepDiveText' in data) || data.deepDiveText == null || (data.deepDiveText is string && data.deepDiveText.size() <= 50000)) &&
        (!('reactionCounts' in data) || data.reactionCounts == null || (data.reactionCounts is map && data.reactionCounts.size() <= 10)) &&
        (!('totalReactions' in data) || data.totalReactions == null || (data.totalReactions is int && data.totalReactions >= 0)) &&
        (!('commentCount' in data) || data.commentCount == null || (data.commentCount is int && data.commentCount >= 0)) &&
        (!('reportedBy' in data) || data.reportedBy == null || (data.reportedBy is list && data.reportedBy.size() <= 1000));
    }

    function isValidReaction(data) {
      return data.keys().hasOnly(['emoji', 'reactedAt']) &&
        data.emoji is string && data.emoji.size() > 0 && data.emoji.size() <= 32 &&
        (!('reactedAt' in data) || data.reactedAt is timestamp);
    }

    function isValidComment(data) {
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'text',
          'createdAt',
          'reportedBy'
        ]) &&
        data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 280 &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('reportedBy' in data) || data.reportedBy == null || (data.reportedBy is list && data.reportedBy.size() <= 1000));
    }

    function isValidModerationReport(data) {
      return data.keys().hasOnly([
          'reporterUid',
          'targetType',
          'targetId',
          'postId',
          'commentId',
          'reportedAuthorUid',
          'reason',
          'createdAt'
        ]) &&
        data.reporterUid is string &&
        data.reporterUid == request.auth.uid &&
        data.reporterUid.size() <= 128 &&
        (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 1000)) &&
        (!('targetType' in data) || data.targetType == null || (data.targetType is string && data.targetType.size() <= 64)) &&
        (!('targetId' in data) || data.targetId == null || (data.targetId is string && data.targetId.size() <= 256)) &&
        (!('postId' in data) || data.postId == null || (data.postId is string && data.postId.size() <= 256)) &&
        (!('commentId' in data) || data.commentId == null || (data.commentId is string && data.commentId.size() <= 256)) &&
        (!('reportedAuthorUid' in data) || data.reportedAuthorUid == null || (data.reportedAuthorUid is string && data.reportedAuthorUid.size() <= 128)) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidDeviceDoc(data) {
      return data.keys().hasOnly([
          'fcmToken',
          'platform',
          'language',
          'timezone',
          'updatedAt'
        ]) &&
        data.keys().hasAll(['fcmToken', 'platform']) &&
        data.fcmToken is string &&
        data.fcmToken.size() > 0 &&
        data.fcmToken.size() <= 512 &&
        data.platform is string &&
        data.platform == 'ios' &&
        (!('language' in data) || (data.language is string && data.language in ['en', 'tr', 'ja', 'de', 'fr', 'es', 'ko'])) &&
        (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidNotificationPrefs(data) {
      return data.keys().hasOnly([
          'dailyReminderEnabled',
          'reminderHour',
          'reminderMinute',
          'commentPushEnabled',
          'dailyDigestEnabled',
          'timezone',
          'language',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'dailyReminderEnabled',
          'reminderHour',
          'reminderMinute',
          'commentPushEnabled',
          'dailyDigestEnabled',
          'timezone',
          'language'
        ]) &&
        data.dailyReminderEnabled is bool &&
        data.reminderHour is int &&
        data.reminderHour >= 0 &&
        data.reminderHour <= 23 &&
        data.reminderMinute is int &&
        data.reminderMinute >= 0 &&
        data.reminderMinute <= 59 &&
        data.commentPushEnabled is bool &&
        data.dailyDigestEnabled is bool &&
        data.timezone is string &&
        data.timezone.size() > 0 &&
        data.timezone.size() <= 64 &&
        data.language is string &&
        data.language in ['en', 'tr', 'ja', 'de', 'fr', 'es', 'ko'] &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidReactionKeyDelta(oldCounts, newCounts, key, expectedDelta) {
      let diff = newCounts.diff(oldCounts);
      let oldVal = (key in oldCounts && oldCounts[key] is int) ? oldCounts[key] : 0;
      return diff.affectedKeys().size() == 1 &&
        diff.affectedKeys().hasOnly([key]) &&
        key in newCounts &&
        newCounts[key] is int &&
        newCounts[key] >= 0 &&
        newCounts[key] == oldVal + expectedDelta;
    }

    function isValidReactionUpdate(postId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let reactionChanged = changed.hasAny(['reactionCounts', 'totalReactions']);
      let reactionPath = /databases/$(database)/documents/shared_posts/$(postId)/reactions/$(request.auth.uid);
      let oldCounts = ('reactionCounts' in resource.data && resource.data.reactionCounts is map)
        ? resource.data.reactionCounts
        : {};
      let oldTotal = ('totalReactions' in resource.data && resource.data.totalReactions is int)
        ? resource.data.totalReactions
        : 0;
      return !reactionChanged || (
        'reactionCounts' in request.resource.data &&
        request.resource.data.reactionCounts is map &&
        'totalReactions' in request.resource.data &&
        request.resource.data.totalReactions is int &&
        request.resource.data.totalReactions >= 0 &&
        (
          (!exists(reactionPath) &&
           existsAfter(reactionPath) &&
           request.resource.data.totalReactions == oldTotal + 1 &&
           isValidReactionKeyDelta(oldCounts, request.resource.data.reactionCounts, getAfter(reactionPath).data.emoji, 1)) ||
          (exists(reactionPath) &&
           !existsAfter(reactionPath) &&
           request.resource.data.totalReactions == oldTotal - 1 &&
           isValidReactionKeyDelta(oldCounts, request.resource.data.reactionCounts, get(reactionPath).data.emoji, -1))
        )
      );
    }

    function isValidCommentCountUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldCount = ('commentCount' in resource.data && resource.data.commentCount is int)
        ? resource.data.commentCount
        : 0;
      return !changed.hasAny(['commentCount']) || (
        'commentCount' in request.resource.data &&
        request.resource.data.commentCount is int &&
        request.resource.data.commentCount >= 0 &&
        request.resource.data.commentCount - oldCount >= -1 &&
        request.resource.data.commentCount - oldCount <= 1
      );
    }

    function isValidReportedByAppend() {
      let oldList = ('reportedBy' in resource.data && resource.data.reportedBy is list)
        ? resource.data.reportedBy
        : [];
      return 'reportedBy' in request.resource.data &&
        request.resource.data.reportedBy is list &&
        request.auth.uid in request.resource.data.reportedBy &&
        request.resource.data.reportedBy.hasAll(oldList) &&
        request.resource.data.reportedBy.size() <= oldList.size() + 1 &&
        request.resource.data.reportedBy.size() >= oldList.size();
    }

    // ===============================================================
    // 1. Users & Social Graph Subcollections
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'isPro',
          'is_pro',
          'entitlement',
          'entitlements',
          'tier',
          'plan',
          'subscriptionStatus',
          'quota',
          'usage'
        ]) &&
        isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'isPro',
          'is_pro',
          'entitlement',
          'entitlements',
          'tier',
          'plan',
          'subscriptionStatus',
          'quota',
          'usage'
        ]) &&
        isValidUserProfile(request.resource.data, userId) &&
        isValidUsernameUpdate() &&
        (!('id' in resource.data) || ('id' in request.resource.data && request.resource.data.id == resource.data.id)) &&
        (!('createdAt' in resource.data) || ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if isOwner(userId);

      match /following/{targetUid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId) &&
          userId != targetUid &&
          !exists(/databases/$(database)/documents/users/$(targetUid)/blocked_users/$(request.auth.uid)) &&
          isValidFollowDoc(request.resource.data);
        allow delete: if isAuthenticated() &&
          (request.auth.uid == userId || request.auth.uid == targetUid);
      }

      match /followers/{followerUid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          request.auth.uid == followerUid &&
          userId != followerUid &&
          !exists(/databases/$(database)/documents/users/$(userId)/blocked_users/$(request.auth.uid)) &&
          isValidFollowDoc(request.resource.data);
        allow delete: if isAuthenticated() &&
          (request.auth.uid == followerUid || request.auth.uid == userId);
      }

      match /blocked_users/{blockedUid} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBlockedUserDoc(request.resource.data);
      }

      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          deviceId.size() <= 128 &&
          isValidDeviceDoc(request.resource.data);
      }

      match /notification_prefs/{prefId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          prefId == 'settings' &&
          isValidNotificationPrefs(request.resource.data);
      }
    }

    // ===============================================================
    // 1b. Atomic @username Uniqueness Reservations
    // ===============================================================

    match /usernames/{handle} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        handle.matches('^[a-z0-9_.]{3,20}$') &&
        !exists(/databases/$(database)/documents/usernames/$(handle)) &&
        isValidUsernameReservation(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 2. Shared Posts, Reactions & Comments
    // ===============================================================

    match /shared_posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        (!('reportedBy' in request.resource.data) || request.resource.data.reportedBy == []) &&
        isValidSharedPost(request.resource.data);

      allow delete: if isAuthenticated() &&
        resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() &&
        isValidSharedPost(request.resource.data) &&
        (
          (resource.data.authorId == request.auth.uid &&
           request.resource.data.authorId == resource.data.authorId &&
           request.resource.data.get('reportedBy', []) == resource.data.get('reportedBy', [])) ||
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactionCounts', 'totalReactions', 'commentCount', 'reportedBy']) &&
           request.resource.data.authorId == resource.data.authorId &&
           request.resource.data.text == resource.data.text &&
           request.resource.data.title == resource.data.title &&
           isValidReactionUpdate(postId) &&
           isValidCommentCountUpdate() &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportedBy']) ||
            isValidReportedByAppend()))
        );

      match /reactions/{reactionUid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          request.auth.uid == reactionUid &&
          isValidReaction(request.resource.data);
        allow delete: if isAuthenticated() &&
          (request.auth.uid == reactionUid || isPostAuthor(postId));
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          (!('reportedBy' in request.resource.data) || request.resource.data.reportedBy == []) &&
          isValidComment(request.resource.data);

        allow delete: if isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || isPostAuthor(postId));

        allow update: if isAuthenticated() &&
          isValidComment(request.resource.data) &&
          (
            (resource.data.authorId == request.auth.uid &&
             request.resource.data.authorId == resource.data.authorId &&
             request.resource.data.get('reportedBy', []) == resource.data.get('reportedBy', [])) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy']) &&
             request.resource.data.authorId == resource.data.authorId &&
             request.resource.data.text == resource.data.text &&
             isValidReportedByAppend())
          );
      }
    }

    // ===============================================================
    // 3. Moderation Reports
    // ===============================================================

    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporterUid == request.auth.uid &&
        isValidModerationReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // ===============================================================
    // 4. Server-Managed Entitlements & Daily Usage Quotas
    // ===============================================================

    // Written exclusively by the Cloud Run backend using Firebase Admin SDK.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Document ID format: {uid}_{yyyymmdd}; written exclusively by Firebase Admin SDK.
    match /usage/{docId} {
      allow read: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_[0-9]{8}$');
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 5. Server-Only Notification Infrastructure
    // ===============================================================

    // Written and read exclusively by Cloud Run / Cloud Scheduler via Firebase Admin SDK.
    match /notification_queue/{docId} {
      allow read, write: if false;
    }

    // Written and read exclusively by Cloud Run via Firebase Admin SDK.
    match /notification_cooldowns/{docId} {
      allow read, write: if false;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

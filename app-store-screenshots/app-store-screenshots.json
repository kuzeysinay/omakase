      {
        "id": "omakase_slide_02",
        "layout": "device-bottom",
        "label": {
          "en": "12 DISCIPLINES",
          "ja": "十二の教養",
          "de": "12 DISZIPLINEN",
          "fr": "12 DISCIPLINES",
          "es": "12 DISCIPLINAS",
          "ko": "12가지 교양"
        },
        "headline": {
          "tr": "tek dokunuşta fun-fact.\n\npostu ai anlık üretir.\n\nkaynağını da verir.",
          "en": "fun-facts in one tap.\n\nwritten live by ai.\n\nalways with its source.",
          "ja": "ひと触れでfun-fact。\nAIが即座に執筆。\n出典も明記。",
          "de": "Fun-Facts mit einem Tipp.\n\nLive von KI verfasst.\n\nImmer mit Quelle.",
          "fr": "Des fun-facts en un geste.\n\nRédigé en direct par l'IA.\n\nToujours avec sa source.",
          "es": "Fun-facts en un toque.\n\nCreado al instante por IA.\n\nSiempre con su fuente.",
          "ko": "한 번의 터치로 fun-fact.\n\nAI가 즉시 작성합니다.\n\n출처도 함께 제공합니다."
        },
        "screenshot": "/screenshots/apple/iphone/{locale}/02.png",
        "transforms": {
          "caption": {
            "x": 45.51036284006341,
            "y": 325.40641508896226,
            "width": 1233,
            "height": 675,
            "rotation": 0,

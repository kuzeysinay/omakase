      {
        "id": "omakase_slide_04",
        "layout": "device-bottom",
        "label": {
          "en": "READING RITUAL",
          "tr": "OKUMA RİTÜELİ",
          "ja": "静かな余韻",
          "de": "LESERITUAL",
          "fr": "RITUEL DE LECTURE",
          "es": "RITUAL DE LECTURA",
          "ko": "독서 의식"
        },
        "headline": {
          "en": "\nA brief pause to read.\n\nSo every bite sinks in.\n",
          "tr": "\nOkuma süresi kadar beklenir.\n\nOkuyup sindirmen için.\n",
          "ja": "\n読む時間だけ、少し待つ。\n\nしっかり味わうために。\n",
          "de": "\nEine kurze Lesepause.\n\nDamit es wirklich wirkt.\n",
          "fr": "\nUne pause le temps de lire.\n\nPour vraiment savourer.\n",
          "es": "\nUna pausa para leer.\n\nPara absorberlo de verdad.\n",
          "ko": "\n읽는 시간만큼 잠시 멈춤.\n\n온전히 음미할 수 있게.\n"
        },
        "screenshot": "/screenshots/apple/iphone/{locale}/04.png",

      {
        "id": "omakase_slide_02",
        "layout": "device-bottom",
        "label": {
          "en": "12 DISCIPLINES",
          "ja": "十二の教養",
          "de": "12 DISZIPLINEN",
          "fr": "12 DISCIPLINES",
          "es": "12 DISCIPLINAS",
          "ko": "12가지 교양"
        },
        "headline": {
          "tr": "\n\nTek dokunuşta fun-fact.\n\nPostu AI anlık üretir.\n\nKaynağını da verir.",
          "en": "\n\nFun-facts in one tap.\n\nAI crafts each post live.\n\nAlways with its source.",
          "ja": "\n\nひと触れでfun-fact。\n\nAIがその場で紡ぎ、\n\n一次出典まで添える。",
          "de": "\n\nFun-Facts mit einem Tipp.\n\nKI erstellt ihn sofort.\n\nImmer mit Quelle.",
          "fr": "\n\nDes fun-facts en un geste.\n\nL'IA rédige à l'instant.\n\nToujours avec sa source.",
          "es": "\n\nFun-facts en un toque.\n\nLa IA lo crea al instante.\n\nSiempre con su fuente.",
          "ko": "\n\n한 번의 터치로 fun-fact.\n\nAI가 즉시 글을 짓고,\n\n출처까지 함께 전해요."
        },
        "screenshot": "/screenshots/apple/iphone/{locale}/02.png",
        "transforms": {
          "caption": {
            "x": 9.599922740218517,
            "y": 157.42881077266034,

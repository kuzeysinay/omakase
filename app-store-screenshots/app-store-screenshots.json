      {
        "id": "omakase_slide_06",
        "layout": "device-bottom",
        "label": {
          "en": "SUBTOPICS",
          "tr": "ALT KONULAR",
          "ja": "小テーマ",
          "de": "UNTERTHEMEN",
          "fr": "SOUS-THÈMES",
          "es": "SUBTEMAS",
          "ko": "세부 주제"
        },
        "headline": {
          "tr": "Kategorini aç.\n\nİlginç bir alt konuya dokun.",
          "en": "Open any discipline.\n\nTap the subtopic that sparks you.",
          "ja": "分野を開く。\n\n惹かれる小テーマをタップ。",
          "de": "Öffne eine Disziplin.\n\nTippe auf dein Unterthema.",
          "fr": "Ouvre une discipline.\n\nTouche le sous-thème qui t'attire.",
          "es": "Abre una disciplina.\n\nToca el subtema que te atrape.",
          "ko": "분야를 여세요.\n\n끌리는 세부 주제를 탭하세요."
        },
